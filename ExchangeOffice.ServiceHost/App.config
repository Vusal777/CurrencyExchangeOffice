<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <appSettings>
    <add key="UseDatabase" value="false" />
    <add key="ExchangeSpreadPercent" value="2.00" />
  </appSettings>
  <connectionStrings>
    <add name="ExchangeOfficeDb" connectionString="Data Source=(LocalDB)\MSSQLLocalDB;Initial Catalog=ExchangeOfficeDb;Integrated Security=True" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <system.serviceModel>
    <services>
      <service name="ExchangeOffice.Service.ExchangeOfficeService" behaviorConfiguration="ExchangeOfficeBehavior">
        <host>
          <baseAddresses>
            <add baseAddress="http://localhost:8080/ExchangeOfficeService.svc" />
          </baseAddresses>
        </host>
        <endpoint address="" binding="basicHttpBinding" contract="ExchangeOffice.Service.IExchangeOfficeService" />
        <endpoint address="mex" binding="mexHttpBinding" contract="IMetadataExchange" />
      </service>
    </services>
    <behaviors>
      <serviceBehaviors>
        <behavior name="ExchangeOfficeBehavior">
          <serviceMetadata httpGetEnabled="true" />
          <serviceDebug includeExceptionDetailInFaults="true" />
        </behavior>
      </serviceBehaviors>
    </behaviors>
  </system.serviceModel>
</configuration>
