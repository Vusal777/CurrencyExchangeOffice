<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <system.serviceModel>
    <bindings>
      <basicHttpBinding>
        <binding name="ExchangeOfficeBinding"
                 openTimeout="00:00:05"
                 closeTimeout="00:00:05"
                 sendTimeout="00:00:10"
                 receiveTimeout="00:00:10" />
      </basicHttpBinding>
    </bindings>
    <client>
      <endpoint name="ExchangeOfficeEndpoint"
                address="http://localhost:8080/ExchangeOfficeService.svc"
                binding="basicHttpBinding"
                bindingConfiguration="ExchangeOfficeBinding"
                contract="ExchangeOffice.WpfClient.IExchangeOfficeService" />
    </client>
  </system.serviceModel>
</configuration>
